{
  "name": "ddp-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Death Drive Pictures — static, content-driven film and series website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --review --watch",
    "build": "node scripts/build.mjs",
    "build:review": "node scripts/build.mjs --review",
    "preview": "node scripts/serve.mjs",
    "intake": "python3 scripts/intake.py",
    "intake:scan": "python3 scripts/intake.py --scan",
    "test": "node --test tests/*.test.mjs",
    "test:images": "python3 tests/image_tools_test.py",
    "test:browser": "python3 tests/browser_check.py",
    "check": "node scripts/check.mjs",
    "release:check": "node scripts/check.mjs --release"
  }
}
